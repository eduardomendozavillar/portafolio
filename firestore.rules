// Deny-all Firestore rules (v1): the only access path to Firestore is the
// server-side Route Handlers via the Admin SDK, which bypasses these rules.
// No direct client read/write is ever allowed.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}